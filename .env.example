# ─── Copy this file to .env and the app boots immediately. ──────────────────
# All values below are working defaults for local development. **Replace every
# secret before deploying**; they are deliberately not random.

# Server
NODE_ENV=development
PORT=3000

# Database
DB_URL=mongodb://localhost:27017/nepal_yatra_dev

# JWT / sessions — each must be >= 32 chars. In production generate with:
#   openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_at_least_32
SESSION_SECRET=dev_session_secret_change_me_in_production_at_least_32

# Token lifetime (s|m|h|d). Access is short-lived; refresh is long-lived.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origins allowed by CORS. In development, http://localhost:3xxx is
# auto-allowed too. CLIENT_URL = public site, ADMIN_PANEL_URL = admin panel.
CLIENT_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3002
ALLOWED_ORIGINS=https://nepalyatratours.com,https://admin.nepalyatratours.com

# Cookies — only set in production behind a parent domain
# COOKIE_DOMAIN=.nepalyatratours.com
COOKIE_SAME_SITE=lax

# bcrypt cost (10–15; 12 is the production minimum)
BCRYPT_SALT_ROUNDS=12

# Logging — fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── SuperAdmin (seeded at boot) ─────────────────────────────────────────────
# The SuperAdmin admin is created (or promoted) on startup.
# Change SUPERADMIN_PASSWORD before the first run in any non-dev environment.
SUPERADMIN_EMAIL=admin@nepalyatratours.com
SUPERADMIN_PASSWORD=ChangeMe!Now123
SUPERADMIN_NAME=Nepal Yatra Admin

# Confirmation code required by the SuperAdmin "clear database" endpoint.
DB_CLEAR_CONFIRMATION_CODE=12345678

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Only enforced when NODE_ENV=production (dev/test always bypass to avoid
# tripping over hot-reloads and test suites). Set DISABLE_RATE_LIMITS=true to
# force-bypass even in production (e.g. load testing).
# DISABLE_RATE_LIMITS=false
#
# global = every request, per IP. auth = login/register/refresh. public_submit
# = enquiry/contact forms. public_api = public trip/blog/etc reads. money =
# order create / payment initiate / mark-paid (applied directly at the route,
# not via the DB-backed scopes below).
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_SUBMIT_WINDOW_MS=3600000
RATE_LIMIT_PUBLIC_SUBMIT_MAX=5
RATE_LIMIT_PUBLIC_API_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_API_MAX=50
RATE_LIMIT_MONEY_WINDOW_MS=60000
RATE_LIMIT_MONEY_MAX=10

# ─── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5

# ─── Cloudinary (image/video/document uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Root folder every asset is uploaded under.
CLOUDINARY_FOLDER=yatranepaltours
MAX_VIDEO_UPLOAD_SIZE_MB=50

# ─── Lead / enquiry notifications (optional) ────────────────────────────────
# ENQUIRY_NOTIFY_EMAIL=leads@nepalyatratours.com

# ─── OAuth (Google) — optional, leave commented to disable ──────────────────
# OAUTH_STATE_SECRET=dev_oauth_state_secret_replace_in_production_32_chars
# OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/success
# OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/auth/error
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Email ───────────────────────────────────────────────────────────────────
# Transport is picked in this order: Resend → generic SMTP → (legacy Zoho) → no-op.
#
# Option A — Resend (recommended for production):
# RESEND_API_KEY=re_your_key_here
#
# Option B — generic SMTP (Gmail, Zoho, Mailgun, SES, Postmark, self-hosted, or
# Mailpit/MailHog for local dev). Works with any provider:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_SECURE=false        # true for port 465 (implicit TLS), false for 587 (STARTTLS)
#
# Sender + branding (used by all transactional email):
# EMAIL_FROM=Nepal Yatra <hello@nepalyatratours.com>
# MAIL_REPLY_TO=info@nepalyatratours.com
# BRAND_NAME=Nepal Yatra Tours
#
# New public enquiries are emailed here (customer also gets an acknowledgement):
# ENQUIRY_NOTIFY_EMAIL=info@nepalyatratours.com
