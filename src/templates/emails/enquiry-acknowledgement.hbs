<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Thanks for your enquiry — {{appName}}</title>
    <style>
      @media only screen and (max-width: 600px) {
        .container { width: 100% !important; }
        .content { padding: 18px !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f6f8; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial; color:#333333;">
    <span style="display:none; max-height:0; max-width:0; overflow:hidden; font-size:1px; line-height:1px; color:#fff; opacity:0;">
      Thanks{{#if name}}, {{name}}{{/if}}! We've received your enquiry and will be in touch within 24 hours.
    </span>

    <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" style="padding:28px 16px;">
          <table class="container" width="600" cellpadding="0" cellspacing="0" role="presentation"
                 style="width:600px; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(16,24,40,0.06);">
            <!-- Header -->
            <tr>
              <td style="padding:22px 28px; background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);">
                <div style="font-size:13px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:1.5px;">{{appName}}</div>
                <div style="margin-top:6px; font-size:22px; font-weight:700; color:#ffffff;">We've got your enquiry ✅</div>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td class="content" style="padding:24px 28px;">
                <p style="margin:0 0 14px 0; font-size:15px; color:#334155; line-height:1.55;">
                  {{#if name}}Hi {{name}},{{else}}Hi there,{{/if}}
                </p>
                <p style="margin:0 0 14px 0; font-size:15px; color:#334155; line-height:1.55;">
                  Thank you for reaching out to <strong>{{appName}}</strong>. We've received your enquiry{{#if trip}} about <strong>{{trip}}</strong>{{/if}}
                  and one of our travel experts will get back to you within 24 hours.
                </p>

                {{#if message}}
                <p style="margin:0 0 8px 0; font-size:15px; color:#334155;">Here's a copy of what you sent us:</p>
                <div style="margin:0 0 18px 0; padding:14px 16px; background:#f1f5f9; border-left:3px solid #1f8a4c;
                            border-radius:0 8px 8px 0; color:#334155; font-size:14px; line-height:1.6; white-space:pre-wrap;">{{message}}</div>
                {{/if}}

                <p style="margin:0 0 20px 0; font-size:15px; color:#334155; line-height:1.55;">
                  In the meantime, feel free to explore more of our journeys.
                </p>

                <table cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td style="border-radius:6px; background:#1f8a4c;">
                      <a href="{{clientUrl}}"
                         style="display:inline-block; padding:12px 22px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:6px;">
                        Explore trips &amp; tours
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:18px 28px; border-top:1px solid #e5e7eb; font-size:12px; color:#9ca3af;">
                Need a faster response? Reply to this email and it'll reach our team directly.
                <div style="margin-top:6px;">&copy; {{year}} {{appName}}. All rights reserved.</div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
