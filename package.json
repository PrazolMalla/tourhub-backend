{
  "name": "nepal-yatra-backend",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Nepal Yatra — class-based Node.js + Express + TypeScript + MongoDB API",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc && tsc-alias && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,json}\"",
    "format": "prettier --write \"src/**/*.{ts,json,md}\" \"*.{json,md}\"",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand --passWithNoTests",
    "seed:content": "tsx scripts/seed-content.ts",
    "seed:fresh": "tsx scripts/seed-content.ts --reset",
    "seed:vehicles": "tsx scripts/seed-vehicles.ts",
    "seed:holidays": "tsx scripts/seed-holidays.ts",
    "seed:checklists": "tsx scripts/seed-school-trip-checklists.ts",
    "seed:blog": "tsx scripts/seed-blog-posts.ts",
    "seed:demo-trips": "tsx scripts/seed-demo-trips.ts",
    "seed:seo": "tsx scripts/seed-seo.ts",
    "seed:seo:force": "tsx scripts/seed-seo.ts --force",
    "gather:assets": "tsx scripts/gather-assets.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "mail:test:customer": "tsx scripts/mail-test-customer.ts",
    "prod:deploy": "bash deploy/deploy.sh",
    "prod:start": "pnpm build && pm2 start deploy/ecosystem.config.js --env production && pm2 save",
    "prod:restart": "pm2 reload deploy/ecosystem.config.js --env production --update-env",
    "prod:stop": "pm2 stop nepal-yatra-backend",
    "prod:logs": "pm2 logs nepal-yatra-backend",
    "prod:status": "pm2 status nepal-yatra-backend",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/geoip-lite": "^1.4.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "geoip-lite": "^2.0.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.0.0",
    "nodemailer": "^8.0.7",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "resend": "^6.14.0",
    "uuid": "^11.0.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
